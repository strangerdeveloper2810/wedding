---
// Ảnh tối ưu: <picture> tự chọn AVIF → WebP → JPEG (fallback).
// Yêu cầu đã chạy `pnpm optimize:img` để có sẵn bản .avif/.webp cạnh .jpeg trong /public/assets.
interface Props {
  src: string; // vd: /assets/concept-2.jpeg
  alt: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  draggable?: boolean;
  width?: number;
  height?: number;
}
const {
  src,
  alt,
  class: className,
  loading = 'lazy',
  fetchpriority,
  draggable,
  width,
  height,
} = Astro.props;
const base = src.replace(/\.(jpe?g|png)$/i, '');
---

<picture>
  <source srcset={`${base}.avif`} type="image/avif" />
  <source srcset={`${base}.webp`} type="image/webp" />
  <img
    src={src}
    alt={alt}
    class={className}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding="async"
    draggable={draggable}
    width={width}
    height={height}
  />
</picture>
