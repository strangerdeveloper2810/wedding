# Supabase — copy file này thành `.env` rồi điền giá trị thật (KHÔNG commit .env)
# Lấy ở: Supabase Dashboard → Project Settings → API
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Khi deploy (Vercel/Netlify/Cloudflare): thêm 2 biến trên vào Environment Variables.
